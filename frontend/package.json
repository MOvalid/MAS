        "@tanstack/react-query": "^5.90.7",
        "axios": "^1.13.2",
        "expo": "~54.0.20",
        "expo-font": "~14.0.9",
        "expo-status-bar": "~3.0.8",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-native": "0.81.5",
        "react-native-dotenv": "^3.4.11",
        "react-native-paper": "^5.14.5",
        "react-native-paper-dates": "^0.22.50",
